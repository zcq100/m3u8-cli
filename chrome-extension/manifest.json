{
  "manifest_version": 3,
  "name": "m3u8-cli 链接检测器",
  "version": "1.8.3",
  "description": "识别页面中的 m3u8 播放列表，复制链接或发送到本地 m3u8-cli 服务下载。",
  "minimum_chrome_version": "116",
  "permissions": ["webRequest", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "m3u8-cli 链接检测器"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
